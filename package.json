{
  "name": "lingyun-zhao-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node --env-file-if-exists=.env --experimental-strip-types scripts/dev-api.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "rag:build": "node --env-file-if-exists=.env --experimental-strip-types scripts/build-rag-index.ts",
    "rag:test": "node --env-file-if-exists=.env --experimental-strip-types scripts/debug-rag.ts",
    "rag:regression": "node --env-file-if-exists=.env --experimental-strip-types scripts/regression-rag.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "openai": "^7.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
